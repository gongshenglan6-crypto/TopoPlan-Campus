# Copy to .env. No quotes. Values are loaded as literal text.
TOPO_DB_URL=jdbc:mysql://127.0.0.1:3306/topo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
TOPO_DB_USERNAME=root
TOPO_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
TOPO_CONFIG_ENCRYPTION_KEY=CHANGE_ME_RANDOM_ENCRYPTION_SECRET
TOPO_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
TOPO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
TOPO_BOOTSTRAP_ENABLED=true
TOPO_SESSION_COOKIE_SECURE=false
# Enable secure cookies when deployed behind HTTPS.

# Server only; fill locally and keep out of Git.
TOPO_MODEL_KEY_PRIMARY=
