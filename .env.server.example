# Copy to .env on the server. Replace every CHANGE_ME value.
TOPO_DB_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_ROOT_PASSWORD
TOPO_CONFIG_ENCRYPTION_KEY=CHANGE_ME_RANDOM_STABLE_ENCRYPTION_SECRET
TOPO_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
TOPO_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
TOPO_SESSION_COOKIE_SECURE=true
TOPO_DEMO_PORT=8188
# A real domain pointing to your server; needed for public HTTPS.
DEMO_HOST=CHANGE_ME_DOMAIN

# Server only; fill locally and keep out of Git.
TOPO_MODEL_KEY_PRIMARY=
